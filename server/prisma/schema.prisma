// Prisma Schema for NurHost - Cloud Storage & Media Vault Platform
// Supports: MySQL (Production/aaPanel) and SQLite (Local Dev)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid()) @db.VarChar(36)
  email         String         @unique @db.VarChar(255)
  passwordHash  String         @db.VarChar(255)
  name          String?        @db.VarChar(100)
  plan          String         @default("free") @db.VarChar(20)
  storageUsed   BigInt         @default(0)
  storageLimit  BigInt         @default(16106127360)
  is2FAEnabled  Boolean        @default(false)
  twoFASecret   String?        @db.VarChar(255)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  files         File[]
  folders       Folder[]
  shareLinks    ShareLink[]
  downloadJobs  DownloadJob[]
  extractionJobs ExtractionJob[]
  activityLogs  ActivityLog[]
}

model Folder {
  id          String         @id @default(uuid()) @db.VarChar(36)
  name        String         @db.VarChar(255)
  userId      String         @db.VarChar(36)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId    String?        @db.VarChar(36)
  parent      Folder?        @relation("FolderToFolder", fields: [parentId], references: [id], onDelete: Cascade)
  children    Folder[]       @relation("FolderToFolder")
  files       File[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model File {
  id               String          @id @default(uuid()) @db.VarChar(36)
  userId           String          @db.VarChar(36)
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  folderId         String?         @db.VarChar(36)
  folder           Folder?         @relation(fields: [folderId], references: [id], onDelete: SetNull)
  originalFilename String          @db.VarChar(500)
  cleanFilename    String          @db.VarChar(500)
  size             BigInt
  mimeType         String          @db.VarChar(200)
  storagePath      String          @db.VarChar(1000)
  hash             String?         @db.VarChar(64)
  isStarred        Boolean         @default(false)
  isTrash          Boolean         @default(false)
  trashedAt        DateTime?
  isTextEditable   Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  shareLinks       ShareLink[]
  versions         FileVersion[]
  extractionJobs   ExtractionJob[]
}

model ShareLink {
  id            String    @id @default(uuid()) @db.VarChar(36)
  fileId        String    @db.VarChar(36)
  file          File      @relation(fields: [fileId], references: [id], onDelete: Cascade)
  userId        String    @db.VarChar(36)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token         String    @unique @db.VarChar(100)
  passwordHash  String?   @db.VarChar(255)
  expiresAt     DateTime?
  maxDownloads  Int?
  downloadCount Int       @default(0)
  createdAt     DateTime  @default(now())
}

model DownloadJob {
  id           String   @id @default(uuid()) @db.VarChar(36)
  userId       String   @db.VarChar(36)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceType   String   @db.VarChar(20)
  source       String   @db.Text
  status       String   @default("pending") @db.VarChar(20)
  progress     Float    @default(0)
  fileId       String?  @db.VarChar(36)
  errorMessage String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ExtractionJob {
  id                  String    @id @default(uuid()) @db.VarChar(36)
  userId              String    @db.VarChar(36)
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  archiveFileId       String    @db.VarChar(36)
  archiveFile         File      @relation(fields: [archiveFileId], references: [id], onDelete: Cascade)
  status              String    @default("pending") @db.VarChar(20)
  progress            Float     @default(0)
  password            String?   @db.VarChar(255)
  destinationFolderId String?   @db.VarChar(36)
  filesSelected       String?   @db.Text
  errorMessage        String?   @db.Text
  createdAt           DateTime  @default(now())
  completedAt         DateTime?
}

model FileVersion {
  id            String   @id @default(uuid()) @db.VarChar(36)
  fileId        String   @db.VarChar(36)
  file          File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  versionNumber Int
  storagePath   String   @db.VarChar(1000)
  size          BigInt
  changeSummary String?  @db.VarChar(500)
  createdAt     DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @db.VarChar(36)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String   @db.VarChar(50)
  details   String?  @db.Text
  ipAddress String?  @db.VarChar(45)
  createdAt DateTime @default(now())
}
