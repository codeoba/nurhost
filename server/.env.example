# =============================================
# NurHost Backend Environment Configuration
# =============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ---- Server ----
PORT=5000
NODE_ENV=production

# ---- Storage Provider ----
# Options: local | s3 | contabo | wasabi | minio
STORAGE_PROVIDER=local

# ---- AWS S3 / Contabo / Wasabi / MinIO (S3-compatible) ----
# Only required if STORAGE_PROVIDER=s3 or contabo or wasabi or minio
S3_ACCESS_KEY=your_access_key_here
S3_SECRET_KEY=your_secret_key_here
S3_BUCKET=your-bucket-name
S3_REGION=us-east-1

# Contabo Object Storage endpoint (if using Contabo)
# S3_ENDPOINT=https://eu2.contabostorage.com

# MinIO endpoint (if self-hosting MinIO)
# S3_ENDPOINT=http://localhost:9000

# ---- Database (Prisma) ----
DATABASE_URL="file:./prisma/dev.db"

# ---- Frontend URL (for CORS) ----
FRONTEND_URL=http://localhost:5173
