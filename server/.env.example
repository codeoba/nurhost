# =============================================
# NurHost Backend - Production Configuration
# Domain: nurhost.mdandu.com
# =============================================

# ---- Server ----
PORT=5000
NODE_ENV=production

# ---- Storage Provider ----
# Options: local | s3 | contabo | wasabi | minio
STORAGE_PROVIDER=local

# ---- S3 Storage (optional - uncomment if using cloud storage) ----
# S3_ACCESS_KEY=your_access_key_here
# S3_SECRET_KEY=your_secret_key_here
# S3_BUCKET=your-bucket-name
# S3_REGION=us-east-1
# S3_ENDPOINT=https://eu2.contabostorage.com

# ---- MySQL Database (aaPanel) ----
DATABASE_URL="mysql://sql_nurhost_mdandu_com:b31b1b7540a87@127.0.0.1:3306/sql_nurhost_mdandu_com"

# ---- Frontend URL (CORS) ----
FRONTEND_URL=https://nurhost.mdandu.com
