# =============================================
# NurHost Backend Environment Configuration
# =============================================

# ---- Server ----
PORT=5000
NODE_ENV=production

# ---- Storage Provider ----
# Options: local | s3 | contabo | wasabi | minio
STORAGE_PROVIDER=local

# ---- AWS S3 / Contabo / Wasabi / MinIO (S3-compatible) ----
# Only required if STORAGE_PROVIDER != local
S3_ACCESS_KEY=your_access_key_here
S3_SECRET_KEY=your_secret_key_here
S3_BUCKET=your-bucket-name
S3_REGION=us-east-1
# S3_ENDPOINT=https://eu2.contabostorage.com

# ---- MySQL Database (aaPanel) ----
# Format: mysql://USERNAME:PASSWORD@127.0.0.1:3306/DATABASE_NAME
DATABASE_URL="mysql://sql_nurhost_mdandu_com:YOUR_DB_PASSWORD@127.0.0.1:3306/sql_nurhost_mdandu_com"

# ---- Frontend URL (for CORS) ----
FRONTEND_URL=https://nurhost.mdandu.com
